# Generated by xcodegen — re-run `xcodegen generate` to recreate.
Burrow.xcodeproj/
*.xcworkspace/

# Visual Studio / .NET / WinUI
.vs/
.vscode/
bin/
!/windows/Assets/Mole/bin/
/windows/Assets/Mole/bin/*
!/windows/Assets/Mole/bin/*.ps1
obj/
artifacts/
TestResults/
*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates

# Windows packaging and publish outputs
publish/
*.appx
*.appxbundle
*.msix
*.msixbundle
*.msixupload

# Xcode build artifacts
build/
build_dist/
dist/
DerivedData/
*.swiftpm/

# macOS junk
.DS_Store

# Python test caches
__pycache__/
*.py[cod]

# Agent worktrees and session state
.claude/

# Local-only files
*.xcuserstate
xcuserdata/

# LLVM coverage from `xcodebuild test`
*.profraw
*.profdata
build_test/

# Telemetry secrets (never commit)
scripts/release.env

# local build output (this session's DerivedData)
build_dd/

# Vendored binary frameworks — fetched and checksum-verified, not committed.
# SwiftPM's binary-artifact downloader hangs xcodebuild on release runners;
# see scripts/fetch-sentry.sh and scripts/fetch-sparkle.sh.
macos/vendor/Sentry.xcframework/
macos/vendor/.sentry-*.ok
macos/vendor/Sparkle.framework/
macos/vendor/.sparkle-cache/
.site-deploy/

# Internal planning docs — kept local, not published
plans/
